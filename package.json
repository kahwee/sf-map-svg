{
  "name": "@kahwee/sf-map-svg",
  "version": "0.2.0",
  "description": "Offline SVG maps of San Francisco with district boundaries, parks, landmarks, and BART stations.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "SOURCES.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "demo": "node examples/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm test",
    "prepublishOnly": "pnpm check",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/sf-map-svg.git"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.0.0",
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@xmldom/xmldom": "^0.9.12",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "vite": "^8.3.1"
  },
  "homepage": "https://github.com/kahwee/sf-map-svg#readme",
  "bugs": {
    "url": "https://github.com/kahwee/sf-map-svg/issues"
  },
  "keywords": [
    "san-francisco",
    "svg",
    "maps",
    "districts",
    "geojson"
  ],
  "private": true
}
