{
  "name": "@kahwee/sf-map-svg",
  "version": "1.5.2",
  "description": "Offline SVG maps of San Francisco with district boundaries, parks, landmarks, and BART stations.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./custom-map": {
      "types": "./dist/src/custom-map.d.ts",
      "import": "./dist/src/custom-map.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./data/analysis": {
      "types": "./dist/data/analysis.d.ts",
      "import": "./dist/data/analysis.js"
    },
    "./data/catalog": {
      "types": "./dist/data/catalog.d.ts",
      "import": "./dist/data/catalog.js"
    },
    "./data/coast": {
      "types": "./dist/data/coast.d.ts",
      "import": "./dist/data/coast.js"
    },
    "./data/districts": {
      "types": "./dist/data/districts.d.ts",
      "import": "./dist/data/districts.js"
    },
    "./data/highways": {
      "types": "./dist/data/highways.d.ts",
      "import": "./dist/data/highways.js"
    },
    "./data/landmarks": {
      "types": "./dist/data/landmarks.d.ts",
      "import": "./dist/data/landmarks.js"
    },
    "./data/lookup": {
      "types": "./dist/data/lookup.d.ts",
      "import": "./dist/data/lookup.js"
    },
    "./data/realtor": {
      "types": "./dist/data/realtor.d.ts",
      "import": "./dist/data/realtor.js"
    },
    "./data/roads": {
      "types": "./dist/data/roads.d.ts",
      "import": "./dist/data/roads.js"
    },
    "./data/sf-find": {
      "types": "./dist/data/sf-find.d.ts",
      "import": "./dist/data/sf-find.js"
    },
    "./data/stations": {
      "types": "./dist/data/stations.d.ts",
      "import": "./dist/data/stations.js"
    },
    "./data/*.json": "./dist/data/*.json",
    "./geometry": {
      "types": "./dist/src/geometry.d.ts",
      "import": "./dist/src/geometry.js"
    },
    "./explorer": {
      "types": "./dist/src/explorer.d.ts",
      "import": "./dist/src/explorer.js"
    },
    "./interactive": {
      "types": "./dist/src/interactive.d.ts",
      "import": "./dist/src/interactive.js"
    },
    "./interactive-data": {
      "types": "./dist/src/interactive-data.d.ts",
      "import": "./dist/src/interactive-data.js"
    },
    "./guide": {
      "types": "./dist/src/guide.d.ts",
      "import": "./dist/src/guide.js"
    },
    "./guide/data": {
      "types": "./dist/src/guide-data.d.ts",
      "import": "./dist/src/guide-data.js"
    },
    "./guide/detailed": {
      "types": "./dist/src/guide-detailed.d.ts",
      "import": "./dist/src/guide-detailed.js"
    },
    "./guide/map": {
      "types": "./dist/src/guide-map.d.ts",
      "import": "./dist/src/guide-map.js"
    },
    "./transit": {
      "types": "./dist/src/transit.d.ts",
      "import": "./dist/src/transit.js"
    }
  },
  "files": [
    "dist",
    "docs/EXAMPLES.md",
    "README.md",
    "SOURCES.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "pnpm build && node --test",
    "test:stories": "pnpm build && vitest run --project=storybook",
    "test:stories:coverage": "pnpm build && vitest run --project=storybook --coverage",
    "demo": "pnpm build && node examples/build.mjs",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "check": "pnpm peers check && pnpm lint && pnpm data:check && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check",
    "storybook": "pnpm build && storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "pnpm build && storybook build",
    "data:catalog": "node scripts/build-data-catalog.mjs",
    "data:check": "node scripts/build-data-catalog.mjs --check",
    "typecheck": "pnpm build && tsc -p tsconfig.json",
    "data:normalize-realtor": "node scripts/normalize-realtor.mjs",
    "data:guide": "node scripts/build-guide-data.mjs",
    "report:guide": "node scripts/report-guide-bundle.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "build": "node scripts/build.mjs",
    "lint": "biome check .",
    "audit": "pnpm audit --audit-level high",
    "prepack": "pnpm build",
    "build:pages": "pnpm build && node scripts/build-pages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/sf-map-svg.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "playwright": "^1.63.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "homepage": "https://kahwee.github.io/sf-map-svg/",
  "bugs": {
    "url": "https://github.com/kahwee/sf-map-svg/issues"
  },
  "keywords": [
    "san-francisco",
    "svg",
    "maps",
    "districts",
    "geojson"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
