{
  "name": "@kahwee/sf-map-svg",
  "version": "0.4.0",
  "description": "Offline SVG maps of San Francisco with district boundaries, parks, landmarks, and BART stations.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./data": {
      "types": "./data/index.d.ts",
      "import": "./data/index.js"
    },
    "./data/*.json": "./data/*.json",
    "./geometry": {
      "types": "./src/geometry.d.ts",
      "import": "./src/geometry.js"
    },
    "./explorer": {
      "types": "./src/explorer.d.ts",
      "import": "./src/explorer.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "SOURCES.md",
    "LICENSE",
    "data"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test",
    "demo": "node examples/build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm data:check && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "data:catalog": "node scripts/build-data-catalog.mjs",
    "data:check": "node scripts/build-data-catalog.mjs --check",
    "typecheck": "tsc",
    "data:normalize-realtor": "node scripts/normalize-realtor.mjs",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/sf-map-svg.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.0.0",
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@xmldom/xmldom": "^0.9.12",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "homepage": "https://github.com/kahwee/sf-map-svg#readme",
  "bugs": {
    "url": "https://github.com/kahwee/sf-map-svg/issues"
  },
  "keywords": [
    "san-francisco",
    "svg",
    "maps",
    "districts",
    "geojson"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
