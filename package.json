{
  "name": "@kahwee/sf-map-svg",
  "version": "1.3.7",
  "description": "Offline SVG maps of San Francisco with district boundaries, parks, landmarks, and BART stations.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./custom-map": {
      "types": "./dist/src/custom-map.d.ts",
      "import": "./dist/src/custom-map.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./data/*.json": "./dist/data/*.json",
    "./geometry": {
      "types": "./dist/src/geometry.d.ts",
      "import": "./dist/src/geometry.js"
    },
    "./explorer": {
      "types": "./dist/src/explorer.d.ts",
      "import": "./dist/src/explorer.js"
    },
    "./interactive": {
      "types": "./dist/src/interactive.d.ts",
      "import": "./dist/src/interactive.js"
    },
    "./interactive-data": {
      "types": "./dist/src/interactive-data.d.ts",
      "import": "./dist/src/interactive-data.js"
    },
    "./guide": {
      "types": "./dist/src/guide.d.ts",
      "import": "./dist/src/guide.js"
    },
    "./transit": {
      "types": "./dist/src/transit.d.ts",
      "import": "./dist/src/transit.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SOURCES.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "pnpm build && node --test",
    "demo": "pnpm build && node examples/build.mjs",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "check": "pnpm lint && pnpm data:check && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check",
    "storybook": "pnpm build && storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "pnpm build && storybook build",
    "data:catalog": "node scripts/build-data-catalog.mjs",
    "data:check": "node scripts/build-data-catalog.mjs --check",
    "typecheck": "pnpm build && tsc -p tsconfig.json",
    "data:normalize-realtor": "node scripts/normalize-realtor.mjs",
    "data:guide": "node scripts/build-guide-data.mjs",
    "report:guide": "node scripts/report-guide-bundle.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "build": "node scripts/build.mjs",
    "lint": "biome check .",
    "prepack": "pnpm build",
    "build:pages": "pnpm build && node scripts/build-pages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/sf-map-svg.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.0.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@xmldom/xmldom": "^0.9.12",
    "polygon-clipping": "^0.15.7",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "homepage": "https://kahwee.github.io/sf-map-svg/",
  "bugs": {
    "url": "https://github.com/kahwee/sf-map-svg/issues"
  },
  "keywords": [
    "san-francisco",
    "svg",
    "maps",
    "districts",
    "geojson"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
