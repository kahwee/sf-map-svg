{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "website/**/*.ts",
    "website/shared/dropdown.js",
    "website/election/refresh.js",
    "website/shared/async-cache.js",
    "website/shared/site-map-data.js",
    "website/shared/display-map.js",
    "website/measures/model.js"
  ]
}
