{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "outDir": "dist",
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "data/**/*.ts"]
}
